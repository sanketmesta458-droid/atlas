# Server-only Gemini key. Get one from Google AI Studio, then copy this file to
# .env.local and replace the placeholder. Never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=your_google_ai_studio_key

# Optional: use a different Gemini model. The default is Gemini 3.6 Flash.
# GEMINI_MODEL=gemini-3.6-flash
